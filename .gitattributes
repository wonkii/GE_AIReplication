* text=auto

# Shared source and documentation.
.gitattributes text eol=lf
.gitignore text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ini text eol=crlf
*.uproject text eol=crlf
*.uplugin text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unreal binary assets, including assets inside project plugins.
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable

# Common source art formats. Text files in Content remain ordinary Git files.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
